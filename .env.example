# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MongoDB connection URI (e.g. MongoDB Atlas free tier connection string or local mongodb)
# If omitted or offline, the app seamlessly falls back to a persistent local JSON store in ./data/db.json
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/pte_tracker?retryWrites=true&w=majority"

# Optional simple protection: if set, requires this PIN on app access
APP_PIN=""

# Port for the Node/Express server (default 3000)
PORT=3000
