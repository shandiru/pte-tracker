# MongoDB connection URI (e.g. MongoDB Atlas free tier cluster)
# If omitted or offline, the server falls back to local storage in ./data/db.json
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/pte_tracker?retryWrites=true&w=majority"

# Optional simple PIN protection
APP_PIN=""

# Port to listen on (default 5000)
PORT=5000
